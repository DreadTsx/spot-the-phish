{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "spot-the-phish",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "spot-the-phish",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Example form",
        "description": "Show a simple form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/example-form"
      },
      {
        "label": "⚠️ Reset ALL player data",
        "description": "Wipes every player's streak, stats, and leaderboard scores. Cannot be undone.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-all-data"
      },
      {
        "label": "Reset MY data",
        "description": "Resets your own streak, stats, and today's result. Doesn't affect other players.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-my-data"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit",
    "resetConfirm": "/internal/form/reset-confirm-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "spot_the_phish_dev"
  }
}
